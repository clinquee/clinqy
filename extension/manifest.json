{
  "manifest_version": 3,
  "name": "Clinqy",
  "version": "1.9.16",
  "description": "Lets the Clinqy app (Mac or Windows) see and act on web pages precisely.",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage",
    "debugger",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "bridge.js"
  },
  "action": {
    "default_title": "Clinqy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
