# Clinqy settings. Copy this file to ~/.config/clinqy/env and uncomment what you need:
#
#   mkdir -p ~/.config/clinqy && cp env.example ~/.config/clinqy/env && chmod 600 ~/.config/clinqy/env
#
# One KEY=value per line, no comment after the value. Lines starting with # are ignored. Restart Clinqy after editing.


# ─── 1. Pick ONE model option ────────────────────────────────────────────────────────────────────

# ── A coding CLI you're already logged into (no key needed) ──
# Claude Code is the default: leave every PROVIDER line commented out to use it.
# PROVIDER=claude-cli

# Antigravity CLI (agy): agy, then log in (also toggled via --agy flag or USE_AGY=1)
# PROVIDER=agy-cli
# USE_AGY=1

# Codex CLI: npm i -g @openai/codex, then `codex login`
# PROVIDER=codex-cli

# ── An API key ──
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# PROVIDER=openai
# OPENAI_API_KEY=sk-...

# PROVIDER=gemini
# GEMINI_API_KEY=AIza...

# PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...

# ── A local or self-hosted model (must be a vision model) ──
# PROVIDER=ollama
# LOCAL_MODEL=qwen3-vl
# OPENAI_BASE_URL=http://localhost:11434/v1

# PROVIDER=openai-compatible
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPATIBLE_API_KEY=...
# LOCAL_MODEL=...


# ─── 2. Optional: models and speed ───────────────────────────────────────────────────────────────

# sonnet / haiku / opus pick each provider's matching tier (see the README), or use any model id.
# The agent
# AGY_MODEL=gemini-3.8-flash
# CLAUDE_MODEL=sonnet
# Optional model ID for Codex CLI on macOS; omit to use Codex's configured default.
# CODEX_MODEL=gpt-5-codex
# Helper for routine steps; off to use only AGY_MODEL / CLAUDE_MODEL
# FAST_MODEL=haiku
# Independent research/analysis/drafting/review workers; off keeps all work with the lead
# DELEGATION=on
# DELEGATE_MODEL=haiku
# DELEGATE_CONCURRENCY=3
# DELEGATE_TIMEOUT=90
# DELEGATE_EFFORT=low
# Optional Mac cursor/launcher pacing (default off: direct navigation and non-blocking animation)
# HUMAN_MOTION=off
# low is faster per step; also the reasoning effort for OpenAI/Gemini/Agy
# AGY_EFFORT=low
# CLAUDE_EFFORT=low


# ─── 3. Optional: everything else ────────────────────────────────────────────────────────────────

# Only if a CLI isn't found on its own
# AGY_PATH=/path/to/agy
# CLAUDE_PATH=/path/to/claude
# CODEX_PATH=/path/to/codex
# OpenCode CLI, used when connecting Clinqy to OpenCode over MCP (not a Clinqy model provider)
# OPENCODE_PATH=/path/to/opencode
# Which of the Mac's speech models hears languages both cover: speech (default) | dictation (Hindi always uses dictation)
# VOICE_MODEL=dictation
# auto (the Mac's language) | en | hinglish | hi | a locale like en-GB
# VOICE_LANGUAGE=auto
# Always ask the model, even when a saved workflow matches
# WORKFLOW_FIRST=off
# Don't check GitHub for a new version of Clinqy for Mac (on by default, once a day)
# UPDATE_CHECK=off
# Don't keep the mic open after a spoken task
# FOLLOW_UP=off
# The fast helper only takes over when the agent hands it steps
# FAST_AUTO=off
# Record runs as offline replay fixtures
# REPLAY_RECORD=on
# Message Clinqy tasks from Telegram (menu → Telegram… sets these): the bot's token from @BotFather, and the one chat it listens to
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Background web tasks: signed-in browser tabs through the extension (default), or a separate headless profile.
# BACKGROUND_WEB_MODE=extension
# Preferred connected browser for extension tasks (no browser is launched automatically).
# BACKGROUND_BROWSER=Google Chrome

# Visual observations: auto = initial image, native transitions, document changes and failures;
# always = image every turn; minimal = explicit look, sparse controls and repeated failures.
# Explicit look is always honored. agy uses a required local image-file inspection instruction;
# Claude/Codex/API paths receive embedded images. Unsupported visual models must be changed by the user.
# VISION_POLICY=auto
# VISION_MAX_SIDE=1920
# VISION_MAX_BYTES=800000

# Browser jobs run independently; excess tasks queue. Also adjustable in the task dock (1–16).
# MAX_BACKGROUND_TASKS=3
